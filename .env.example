# ============================================================================
# GASHA DEMO CLINIC — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env for local development. Never commit .env to Git!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Safe for browser exposure via Vite)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLINIC_SLUG=gasha-demo-clinic
VITE_WHATSAPP_PUBLIC_NUMBER=

# ----------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE VARIABLES (Netlify Functions Only — NEVER prefix VITE_)
# ----------------------------------------------------------------------------
# Supabase Server Credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# OpenAI / Groq / Gemini AI API (AI WhatsApp Receptionist)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_LANGUAGE_CODE=en_US

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Application & Security Configuration
APP_URL=https://gashademoclinic.netlify.app
APP_ENV=development
ENCRYPTION_KEY=
JWT_SECRET=
CRON_SECRET=

# International Online Payment Providers (Server-Side Only — Never expose in frontend)
# Compliant Pakistani & International Visa/Mastercard Gateways: Safepay / PayFast / 2Checkout (Verifone)
# Note: Do NOT integrate Easypaisa API (Manual Easypaisa receipt verification only).
# Stripe & PayPal may only be enabled if the clinic holds an eligible foreign/international merchant account.
INTERNATIONAL_PAYMENT_PROVIDER=safepay_pk
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
TWOCHECKOUT_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
